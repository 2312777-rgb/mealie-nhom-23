# URL of a locally running Mealie instance. Do not target public servers.
MEALIE_BASE_URL=http://localhost:3000

# Account created only for testing. Do not commit the real values.
MEALIE_TEST_EMAIL=visual.qa@example.test
MEALIE_TEST_PASSWORD=ChangeThisPassword

# URL slug of the test group. It is visible in URLs after login.
MEALIE_TEST_GROUP_SLUG=home

# QA uses frontend port 3000 and backend host port 19000.
MEALIE_API_URL=http://127.0.0.1:19000
MEALIE_FIXED_DATE=2026-10-12T12:00:00Z
# Explicit opt-in to create QA data in the dedicated local account.
MEALIE_ALLOW_SEED=false
