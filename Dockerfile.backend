FROM python:3.14-slim@sha256:caaf356f40667c496d405780745b9ac25771c189a51dfcc42430d531ea09f8a2
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libsasl2-dev libldap2-dev libssl-dev curl ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.7
WORKDIR /source
COPY pyproject.toml uv.lock ./
COPY mealie ./mealie
RUN uv sync --frozen --no-dev
ENV PRODUCTION=false TESTING=false HOST=0.0.0.0 API_PORT=9000 DATA_DIR=/app/data DB_ENGINE=sqlite
EXPOSE 9000
CMD ["uv", "run", "--no-sync", "python", "mealie/app.py"]
